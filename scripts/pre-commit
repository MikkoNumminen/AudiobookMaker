#!/bin/bash
# Pre-commit hook: mechanical P0 gates + CLI doc sync + tests.
# Install: bash scripts/install-hooks.sh

# ── Interpreter resolution (cross-platform) ─────────────────────────────
# Windows ships the `py` launcher; macOS/Linux don't. ABM_TEST_PYTHON can
# point at a specific interpreter (e.g. a dedicated test venv). Without a
# usable interpreter+pytest the python gates are SKIPPED with a loud
# warning rather than hard-blocking every commit on the machine — the
# pure-shell gates below still run, and CI remains the backstop.
resolve_python() {
    if [ -n "${ABM_TEST_PYTHON:-}" ] && "$ABM_TEST_PYTHON" -c "import sys" >/dev/null 2>&1; then
        echo "$ABM_TEST_PYTHON"; return
    fi
    if command -v py >/dev/null 2>&1; then
        echo "py -3"; return
    fi
    if [ -x ".venv/bin/python" ] && .venv/bin/python -c "import sys" >/dev/null 2>&1; then
        echo ".venv/bin/python"; return
    fi
    if command -v python3 >/dev/null 2>&1; then
        echo "python3"; return
    fi
    echo ""
}
PY="$(resolve_python)"

# ── Mechanical P0 gates (pure shell — always run) ───────────────────────
# 1. TODO.md must never be staged (CLAUDE.md: local-only, never tracked).
# 2. Nothing under .local/ may be staged (CLAUDE.md: third-party source
#    material and generated output live there; pushing any of it is a P0
#    copyright/leak risk).
staged_names=$(git diff --cached --name-only)
if echo "$staged_names" | grep -qE '^TODO\.md$'; then
    echo "BLOCKED: TODO.md is staged. It is local-only and never tracked (CLAUDE.md)."
    echo "Fix: git restore --staged TODO.md"
    exit 1
fi
if echo "$staged_names" | grep -qE '^\.local/'; then
    echo "BLOCKED: files under .local/ are staged. .local/ holds source material"
    echo "and generated output that must never reach the repo (CLAUDE.md P0)."
    echo "Fix: git restore --staged .local/"
    exit 1
fi

# Docs-only shortcut: if every staged change is a pure-asset or
# markdown-style file, skip the test suite entirely. Tests don't
# exercise docs, so running them costs ~12 s for no safety gain.
# Safety net: any non-doc file in the stage (even one) falls back to
# the full run.
#
# NOT in this list on purpose:
# - `.txt` (except LICENSE.txt, explicitly re-allowed): `requirements.txt`
#   is the only other tracked .txt and changes to it absolutely must run
#   tests — a silent dep bump that breaks runtime would otherwise land
#   without any signal.
# - `.yaml`: the `data/*.yaml` files drive the text normalizer (acronyms,
#   loanwords, governors) and tests explicitly exercise them, so a YAML
#   edit must run the suite.
DOC_PATTERN='\.(md|rst|gitattributes|gitignore|mp3|wav|ico|png|jpg)$|^(\.gitattributes|\.gitignore|TODO\.md|README\.md|BUILDING\.md|DEVELOPMENT\.md|CONVENTIONS\.md|LICENSE(\.txt)?)$'

# ── Python gates (need an interpreter) ──────────────────────────────────
if [ -z "$PY" ]; then
    echo "WARNING: no usable Python found (ABM_TEST_PYTHON / py / .venv / python3)."
    echo "Skipping the CLI sync check and the test suite — CI is the backstop."
    echo "Set ABM_TEST_PYTHON to a venv python to restore local gating."
    exit 0
fi

# CLI reference sync check — runs unconditionally so that docs/CLI.md
# stays in sync even on docs-only commits where the test suite is skipped.
# A missing-dependency crash (interpreter without the project deps) is a
# warn-and-skip, not a block — only a REAL out-of-sync report blocks.
echo "Checking docs/CLI.md is in sync with CLI parsers..."
cli_check_out=$($PY scripts/render_cli_help.py --check 2>&1)
cli_check_rc=$?
if [ $cli_check_rc -ne 0 ]; then
    if echo "$cli_check_out" | grep -qE "ModuleNotFoundError|ImportError|Traceback"; then
        echo "WARNING: CLI sync check could not run with $PY (missing deps or"
        echo "wrong Python version) — skipping. Set ABM_TEST_PYTHON to a venv"
        echo "python with the dev deps installed."
    else
        echo "$cli_check_out"
        echo ""
        echo "docs/CLI.md is out of sync with the CLI parsers."
        echo "Run: python scripts/render_cli_help.py"
        exit 1
    fi
fi

# Skill-catalog sync check — also runs unconditionally. Adding a skill or
# editing a catalog is a pure-markdown change, so the docs-only shortcut
# below would otherwise skip the test that enforces this. Pure stdlib, so it
# runs even on an interpreter without the project deps installed (a crash is
# warn-and-skip; only a real drift report blocks).
echo "Checking the skill catalogs match .claude/skills/..."
skill_check_out=$($PY scripts/check_skill_catalog.py 2>&1)
skill_check_rc=$?
if [ $skill_check_rc -ne 0 ]; then
    if echo "$skill_check_out" | grep -qE "ModuleNotFoundError|ImportError|Traceback"; then
        echo "WARNING: skill-catalog check could not run with $PY — skipping."
    else
        echo "$skill_check_out"
        exit 1
    fi
fi

staged=$(git diff --cached --name-only)
if [ -z "$staged" ]; then
    # Nothing staged (e.g. --amend with no changes). Fall through to
    # normal behaviour.
    non_doc=""
else
    # Files that aren't docs. If this is empty, we're docs-only.
    non_doc=$(echo "$staged" | grep -Ev "$DOC_PATTERN" || true)
fi

if [ -z "$non_doc" ] && [ -n "$staged" ]; then
    echo "Docs-only commit detected — skipping tests."
    echo "Staged: $staged"
    exit 0
fi

# Windows pytest-asyncio can occasionally hang inside ProactorEventLoop's
# internal socketpair() during test teardown. pytest-timeout catches it
# (pytest.ini sets timeout=60), but once in a while an otherwise-green
# run fails. Retry once before declaring the commit broken — real test
# failures are reproducible, flakes aren't.
#
# `-m "not slow"` honors the pytest.ini docstring: slow tests run a
# real engine end-to-end and are skipped by default in pre-commit.
# They still run in full CI / manual `pytest` invocations.
#
# test_single_instance.py is ignored to match CI (both Windows test
# workflows skip it): its concurrency test races real threads and flakes
# (~1-in-3), so leaving it in would spuriously block commits with -x. The
# retry-once above can't reliably absorb a coin-flip flake. Everything
# else CI skips for headless-Windows reasons (GUI files, voice recorder)
# passes deterministically on the dev box, so pre-commit keeps running it
# for the extra local coverage.
PYTEST_ARGS=(tests/ --ignore=tests/test_record_voice_sample.py --ignore=tests/test_single_instance.py -m "not slow" -x -q --tb=short)

if ! $PY -c "import pytest" >/dev/null 2>&1; then
    echo "WARNING: $PY has no pytest — skipping the test gate (CI is the backstop)."
    echo "Set ABM_TEST_PYTHON to a venv python with the dev deps installed."
    exit 0
fi

run_tests() {
    $PY -m pytest "${PYTEST_ARGS[@]}" 2>&1
}

echo "Running tests before commit..."
if run_tests; then
    echo "All tests passed."
    exit 0
fi

echo ""
echo "First test run failed — retrying once in case of a Windows asyncio flake..."
if run_tests; then
    echo "All tests passed on retry."
    exit 0
fi

echo ""
echo "Tests FAILED twice — commit blocked. Fix the failures and try again."
exit 1
